+// Pinned host buffers are read back by the CPU (logits, embeddings). Without a host-visible type that is
+// both coherent and cached, the pinned fallback is write-combined memory, where every CPU read is an uncached
+// access (~80 ms per token to sample a 248K vocab on Intel Meteor Lake / Mesa ANV). Regular memory is faster there.
+static bool ggml_vk_has_cached_coherent_host_memory(const vk_device & device) {
+    const vk::MemoryPropertyFlags wanted = vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent | vk::MemoryPropertyFlagBits::eHostCached;
+    const vk::PhysicalDeviceMemoryProperties mem_props = device->physical_device.getMemoryProperties();
+    for (uint32_t i = 0; i < mem_props.memoryTypeCount; ++i) {
+        if ((mem_props.memoryTypes[i].propertyFlags & wanted) == wanted) {
+            return true;
+        }
+    }
+    return false;
+}
